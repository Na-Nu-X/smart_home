# Copy to .env and adjust. All values are optional for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=

# Database: "sqlite" (default) or "postgresql"
DB_ENGINE=sqlite
DB_NAME=smarthome
DB_USER=smarthome
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Lead form throttle (per IP) and floor plan upload limit (bytes)
LEAD_THROTTLE_RATE=20/hour
FLOORPLAN_MAX_UPLOAD_BYTES=15728640
